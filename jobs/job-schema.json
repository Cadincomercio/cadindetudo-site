{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cadin SEO Job",
  "type": "object",
  "required": ["version", "product", "pages", "publish"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "publish": {"type": "boolean"},
    "product": {
      "type": "object",
      "required": ["source_url", "title", "canonical_url"],
      "properties": {
        "source_url": {"type": "string", "minLength": 10},
        "title": {"type": "string", "minLength": 3},
        "description": {"type": "string"},
        "image_url": {"type": "string"},
        "canonical_url": {"type": "string", "minLength": 10},
        "item_id": {"type": "string"},
        "highlights": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 2}
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["slug", "heading", "meta_description", "intro", "why", "observe", "faq_q", "faq_a"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "heading": {"type": "string", "minLength": 5},
          "meta_description": {"type": "string", "minLength": 30, "maxLength": 180},
          "intro": {"type": "string", "minLength": 50},
          "why": {"type": "string", "minLength": 50},
          "observe": {"type": "string", "minLength": 40},
          "faq_q": {"type": "string", "minLength": 10},
          "faq_a": {"type": "string", "minLength": 30},
          "highlights": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 2}
          },
          "checklist": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 5}
          },
          "practical_blocks": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["title", "body"],
              "properties": {
                "title": {"type": "string", "minLength": 5},
                "body": {"type": "string", "minLength": 40}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
